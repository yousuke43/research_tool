    "content": "{\n  \"conditions\": [\n    \"利用時間が16:00〜1:00である\",\n    \"一人あたりの割引前会計総額が4000円以上である\",\n    \"来店時刻が17:00前である\",\n    \"利用人数が4人以上である\",\n    \"口コミを追加する\"\n  ],\n  \"actions\": [\n    {\n      \"name\": \"割引後の最終会計総額\",\n      \"type\": \"value\",\n      \"valueType\": \"float\"\n    }\n  ]\n}",
