    "content": "{\n  \"conditions\": [\n    \"利用人数が4人以上である\",\n    \"個別に会計を行っている\",\n    \"利用者が学生のみである\",\n    \"学生証を提示できる\",\n    \"利用人数が3人以上である\",\n    \"会計金額が10000円をこえている\"\n  ],\n  \"actions\": [\n    {\n      \"name\": \"最終料金\",\n      \"type\": \"value\",\n      \"valueType\": \"float\"\n    }\n  ]\n}",
