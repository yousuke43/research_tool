    "model": "openai/gpt-6-luna",
    "content": "{\n  \"conditions\": [\n    \"3泊以上連泊する\",\n    \"宿泊料金の全額をクレジットカードで決済する\",\n    \"今年、小学校・中学校・高等学校・大学・専門学校のいずれかを卒業した\",\n    \"全ての部屋が同じ宿泊期間で、2部屋以上を予約する\",\n    \"宿泊日の30日以上前に予約する\"\n  ],\n  \"actions\": [\n    {\n      \"name\": \"最終宿泊料金\",\n      \"type\": \"value\",\n      \"valueType\": \"int\"\n    },\n    {\n      \"name\": \"キャッシュバック額\",\n      \"type\": \"value\",\n      \"valueType\": \"int\"\n    }\n  ]\n}",
    "elapsed_sec": 12.18,
